# Server-only Resend credentials. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=re_replace_me
CONTACT_TO_EMAIL=team@geekroom.co.in
CONTACT_FROM_EMAIL=Geek Room Website <team@geekroom.co.in>

# Cloudflare Turnstile. The site key is intentionally public; the secret is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me
TURNSTILE_SECRET_KEY=replace_me

# Optional comma-separated production origins. When omitted, the API requires
# requests to match the current request host.
CONTACT_ALLOWED_ORIGINS=https://geekroom.co.in,https://www.geekroom.co.in

# ---- Geek Room Track (track.geekroom.co.in) ----
# Postgres connection string. Provisioned by the Neon integration on Vercel.
DATABASE_URL=postgres://localhost:5432/geekroom_track
# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=replace_me
# Required in production to create the first core account at /setup.
TRACK_SETUP_KEY=replace_me
